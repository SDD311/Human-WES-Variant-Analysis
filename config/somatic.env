
# Human WES Somatic Variant Analysis
# Matched tumour-normal workflow

PROJECT_NAME=Human-WES-Variant-Analysis
ANALYSIS_TYPE=somatic

THREADS=2
JAVA_MEMORY=4g

GENOME_BUILD=GRCh38
REFERENCE=reference/genome/GRCh38.fa

TARGET_BED=reference/intervals/exome_targets.bed

# Somatic calling resources
GERMLINE_RESOURCE=reference/known_sites/af_only_gnomad.vcf.gz
PON=reference/known_sites/1000g_pon.hg38.vcf.gz

# Metadata
SAMPLE_SHEET=metadata/somatic_samples.csv

# Data directories
FASTQ_DIR=data/somatic/raw_fastq
TRIMMED_DIR=data/somatic/trimmed_fastq

# Results
QC_DIR=results/somatic/qc
ALIGNMENT_DIR=results/somatic/alignment
BAM_DIR=results/somatic/bam
VARIANT_DIR=results/somatic/variants
ANNOTATION_DIR=results/somatic/annotation

# VEP cache
VEP_CACHE=reference/vep_cache

