
# Human WES Germline Variant Analysis
# Configuration

PROJECT_NAME=Human-WES-Variant-Analysis
ANALYSIS_TYPE=germline

# Computing resources
THREADS=2
JAVA_MEMORY=4g

# Human reference genome
GENOME_BUILD=GRCh38
REFERENCE=reference/genome/GRCh38.fa

# Exome capture target intervals
TARGET_BED=reference/intervals/exome_targets.bed

# GATK known-sites resources
DBSNP=reference/known_sites/dbsnp.vcf.gz
MILLS=reference/known_sites/Mills_and_1000G_gold_standard.indels.vcf.gz

# Sample sheet
SAMPLE_SHEET=metadata/germline_samples.csv

# Output directories
FASTQ_DIR=data/germline/raw_fastq
TRIMMED_DIR=data/germline/trimmed_fastq
QC_DIR=results/germline/qc
ALIGNMENT_DIR=results/germline/alignment
VARIANT_DIR=results/germline/variants
